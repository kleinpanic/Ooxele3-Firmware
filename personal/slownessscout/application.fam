# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="slownessscout",  # Must be unique
    name="SlownessScout",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="slownessscout_app",
    stack_size=2 * 1024,
    fap_category="Tools",
    # Optional values
    fap_version=(0, 1),
    fap_description="Frame time & input latency monitor",
    fap_author="User",
    fap_icon="hello_world.png",  # 10x10 1-bit PNG
    fap_icon_assets="images",  # Image assets to compile for this application
)
