# For details & more options, see documentation/AppManifests.md in firmware repo

App(
    appid="flipperhtop",  # Must be unique
    name="FlipperHtop",  # Displayed in menus
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flipperhtop_app",
    stack_size=4 * 1024,
    sources=["flipperhtop.c", "flipperhtop_lib.c"],
    fap_category="Tools",
    # Optional values
    fap_version=(0, 1),
    fap_description="Live thread & heap monitor",
    fap_author="User",
    fap_icon="hello_world.png",  # 10x10 1-bit PNG
    fap_icon_assets="images",  # Image assets to compile for this application
)
